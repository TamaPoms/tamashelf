# Modèle de configuration locale pour docker-compose.yml.
#
# Copie ce fichier vers .env (cp .env.example .env), puis remplace les valeurs
# ci-dessous par les tiennes. .env n'est JAMAIS commité dans git (voir .gitignore) :
# tes vraies valeurs restent uniquement sur ta machine, et un `git pull` pour récupérer
# une mise à jour de docker-compose.yml ne les touchera jamais ni ne rentrera en conflit
# avec elles.

# Chemins réels de tes disques sur la machine hôte (pas dans le conteneur) -- celui qui
# contient nautiljon_mangas.db (DISQUE_1) et un éventuel second disque de scans (DISQUE_2).
DISQUE_1=/mnt/mon_disque_1
DISQUE_2=/mnt/mon_disque_2

# Adresse où app.py (tamajon.py) écoute -- remplace par l'IP réelle de la machine qui le
# fait tourner (cas normal : app.py tourne en dehors de Docker, directement sur cette
# même machine ou une autre du réseau local).
APP_PY_URL=http://192.168.1.XXX:5555
